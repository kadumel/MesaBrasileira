# Copie para .env e preencha (nunca commite o .env)

# Obrigatório em produção (Railway: definir nas Variables do serviço)
SECRET_KEY=altere-para-uma-chave-aleatoria-longa
DEBUG=False
ALLOWED_HOSTS=seudominio.railway.app,localhost,127.0.0.1

# PostgreSQL — local ou URL gerada pelo plugin Postgres no Railway
DATABASE_URL=postgresql://usuario:senha@localhost:5432/mesabrasileira

# CSRF (produção HTTPS); opcional se usar só RAILWAY_PUBLIC_DOMAIN
# CSRF_TRUSTED_ORIGINS=https://seudominio.railway.app

# Desenvolvimento local: deixe comentado ou use a pasta do projeto
# MEDIA_ROOT=

# Railway (volume montado em /data/media):
MEDIA_ROOT=/data/media
